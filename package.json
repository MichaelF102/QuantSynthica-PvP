{
  "name": "quantsynthica-pvp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9 <23"
  },
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "prebuild": "node scripts/check-deploy.mjs",
    "deploy:check": "node scripts/check-deploy.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "predev": "node scripts/dev-data.mjs",
    "dev:offline": "next dev -p 3000",
    "rooms:dev": "wrangler dev --config room-server/wrangler.toml --port 8787",
    "rooms:deploy": "wrangler deploy --config room-server/wrangler.toml",
    "rooms:typecheck": "tsc --noEmit -p room-server",
    "data:refresh": "node scripts/dev-data.mjs --force",
    "data:fetch": ".venv/bin/python scripts/fetch_data.py --symbols NQ=F 6E=F ^GSPC ^NSEI ^DJI ^IXIC ^NSEBANK AAPL MSFT NVDA AMZN GOOGL META TSLA JPM RELIANCE.NS TCS.NS HDFCBANK.NS ICICIBANK.NS INFY.NS SBIN.NS BHARTIARTL.NS ITC.NS LT.NS --days 29",
    "data:index": ".venv/bin/python scripts/build_index.py && .venv/bin/python scripts/build_catalog.py",
    "data:catalog": ".venv/bin/python scripts/build_catalog.py",
    "data:add": "node scripts/dev-data.mjs --add",
    "rooms:e2e": "node room-server/test/e2e.mjs",
    "rules:deploy": "npx -y firebase-tools@15.34.1 deploy --only firestore:rules --project"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "13.1.0",
    "lightweight-charts": "^4.2.3",
    "lucide-react": "^1.67.0",
    "next": "^14.2.35",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
