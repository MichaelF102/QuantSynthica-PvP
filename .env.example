# Copy to .env.local for local development. All optional.

# 1v1 room server host (no https://). Unset in development uses localhost:8787.
NEXT_PUBLIC_ROOM_HOST=

# Google sign-in and cloud progress (README "Accounts"). Leave empty to keep everything in the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
